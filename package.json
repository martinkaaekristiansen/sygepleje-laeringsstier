{
  "name": "laeringsstier",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "test:browser": "npm run test:browser:full",
    "build:preview": "node scripts/build-preview.js",
    "build:preview:3d": "node scripts/build-3d-preview.js",
    "test:browser:digestion-b": "node tests-browser/digestion-phase-b.cjs",
    "test:3d": "node tests-browser/journey-3d.cjs",
    "format": "prettier --write \"public/*.js\" \"test/*.test.js\" \"tests-browser/*.cjs\"",
    "test:browser:digestion-performance": "node tests-browser/digestion-performance.cjs",
    "test:browser:digestion-c": "node tests-browser/digestion-phase-c.cjs",
    "test:browser:digestion-v2": "node tests-browser/digestion-v2.cjs",
    "test:browser:digestion-continuous": "node tests-browser/digestion-continuous.cjs && node tests-browser/digestion-continuous-state.cjs",
    "test:browser:digestion-continuous-performance": "node tests-browser/digestion-continuous-performance.cjs",
    "test:browser:digestion-oral": "node tests-browser/digestion-oral-mobile.cjs",
    "test:browser:digestion-anatomy": "node tests-browser/digestion-labels.cjs && node tests-browser/digestion-hcl.cjs && node tests-browser/digestion-enzyme-continuity.cjs && node tests-browser/digestion-microbiota.cjs",
    "test:browser:digestion-anatomy-performance": "node tests-browser/digestion-anatomy-performance.cjs",
    "test:browser:digestion-anatomy-visual": "node tests-browser/digestion-anatomy-visual.cjs",
    "test:browser:oxygen": "node tests-browser/oxygen-physiology.cjs && node tests-browser/oxygen-visibility.cjs && node tests-browser/oxygen-layout.cjs && node tests-browser/oxygen-audio.cjs && node tests-browser/oxygen-state.cjs && node tests-browser/oxygen-journeys.cjs",
    "test:browser:oxygen-performance": "node tests-browser/oxygen-performance.cjs",
    "test:browser:oxygen-visual": "node tests-browser/oxygen-visual.cjs && node scripts/build-oxygen-gallery.js",
    "test:browser:oxygen-build": "node tests-browser/oxygen-build.cjs",
    "test:syntax": "node scripts/ci/check-syntax.js",
    "test:browser:smoke": "node scripts/ci/run-browser.js core",
    "test:browser:full": "node scripts/ci/run-browser.js core && node scripts/ci/run-browser.js full"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.56.1",
    "postcss": "8.5.33",
    "prettier": "3.6.2",
    "yaml": "2.9.1"
  }
}
